# UX Builder — LLM provider config
#
# Pick ONE provider: "groq" (hosted) or "ollama" (local). You can switch
# freely between them without any code changes.

# --- Option A: Groq (hosted) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Optional model overrides. Any model ID from pi-ai's built-in Groq registry:
#   llama-3.1-8b-instant, llama-3.3-70b-versatile, qwen/qwen3-32b,
#   openai/gpt-oss-20b, openai/gpt-oss-120b, moonshotai/kimi-k2-instruct, ...
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_REASONING=llama-3.3-70b-versatile

# --- Option B: Ollama (local) ---
# Uncomment these (and comment out the Groq block) to run against a local model.
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.5:4b
