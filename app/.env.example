# UX Builder — LLM provider config
#
# Provider: OpenRouter (hit directly via native fetch — no SDK).
# https://openrouter.ai/

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional model slugs. Both default to inclusionai/ling-2.6-1t:free when
# unset. Browse the full catalog at https://openrouter.ai/models.
#   - "fast" is used for cheap/batch ops (session titles, batched detail
#     calls).
#   - "reasoning" is used for user-facing ops (Phase 1 conversation,
#     validation, Phase 2 drift checks).
# You can point them at different models to save money on the cheap ones
# while keeping a larger model for reasoning.
LLM_MODEL_FAST=inclusionai/ling-2.6-1t:free
LLM_MODEL_REASONING=inclusionai/ling-2.6-1t:free

# Optional — override the OpenRouter base URL (useful for self-hosted
# gateways that speak the same protocol).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
